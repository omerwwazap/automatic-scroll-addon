{
  "manifest_version": 3,
  "name": "Auto Page Scroller",
  "version": "1.2.1",
  "description": "Automatically scrolls the page. Click icon for controls. Use Ctrl+Shift+Up/Down to change speed.",
  "homepage_url": "https://github.com/omerwwazap/automatic-scroll-addon",

  "permissions": ["activeTab", "scripting", "storage"],

  "background": {
    "scripts": ["constants.js", "background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_scroll.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Scroller Controls",
    "default_icon": {
      "16": "icons/down-arrow.png",
      "32": "icons/left-arrow.png",
      "48": "icons/right-arrow.png",
      "96": "icons/up-arrow.png"
    }
  },

  "commands": {
    "increase-scroll-speed": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "Command+Shift+Up"
      },
      "description": "Increase Scrolling Speed"
    },
    "decrease-scroll-speed": {
      "suggested_key": {
        "default": "Ctrl+Shift+Down",
        "mac": "Command+Shift+Down"
      },
      "description": "Decrease Scrolling Speed"
    }
  }
}
